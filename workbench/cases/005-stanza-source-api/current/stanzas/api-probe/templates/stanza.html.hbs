<section class="api-probe">
  <h1>Stanza source API probe</h1>
  <dl>
    <dt>element</dt>
    <dd data-probe="element">{{elementTag}}</dd>
    <dt>root</dt>
    <dd data-probe="root">{{rootExists}}</dd>
    <dt>main</dt>
    <dd data-probe="main">{{mainExists}}</dd>
    <dt>render count</dt>
    <dd data-probe="render-count">{{renderCount}}</dd>
    <dt>string param</dt>
    <dd data-probe="string-param">{{stringParam}}</dd>
    <dt>number param</dt>
    <dd data-probe="number-param">{{numberParam}}</dd>
    <dt>boolean param</dt>
    <dd data-probe="boolean-param">{{booleanParam}}</dd>
    <dt>json param</dt>
    <dd data-probe="json-param">{{jsonParam}}</dd>
    <dt>query</dt>
    <dd data-probe="query">{{queryStatus}}</dd>
    <dt>last attribute name</dt>
    <dd data-probe="last-attribute-name">{{lastAttributeName}}</dd>
    <dt>last attribute old value</dt>
    <dd data-probe="last-attribute-old-value">{{lastAttributeOldValue}}</dd>
    <dt>last attribute new value</dt>
    <dd data-probe="last-attribute-new-value">{{lastAttributeNewValue}}</dd>
  </dl>
</section>
