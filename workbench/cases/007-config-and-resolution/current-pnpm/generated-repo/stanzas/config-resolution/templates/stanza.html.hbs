<section class="config-resolution-fixture">
  <p class="config-resolution-fixture__marker">{{fixtureLabel}}</p>
  <p data-local-marker-url="{{localMarkerUrl}}">local asset: {{localMarkerUrl}}</p>
  <p data-package-marker-url="{{packageMarkerUrl}}">package asset: {{packageMarkerUrl}}</p>
  <p data-root-public-asset-path="{{rootPublicAssetPath}}">root asset: {{rootPublicAssetPath}}</p>
  <img src="{{localMarkerUrl}}" alt="case 007 local marker">
  <img src="{{packageMarkerUrl}}" alt="case 007 package marker">
</section>
