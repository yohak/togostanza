{
  "name": "togostanza",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "togostanza": "./bin/togostanza.mjs"
  },
  "type": "module",
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "dev:cli": "tsx src/cli.ts",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "format": "oxfmt -c oxfmt.config.ts .",
    "format:check": "oxfmt -c oxfmt.config.ts --check .",
    "lint": "oxlint -c oxlint.config.ts .",
    "lint:fix": "oxlint -c oxlint.config.ts . --fix",
    "type-check": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "pnpm run build && vitest run --config vitest.integration.config.ts",
    "test:browser": "playwright test --config playwright.config.ts",
    "check-all": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run build && pnpm run test:unit && pnpm run test:integration && pnpm run test:browser"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "handlebars": "^4.7.9",
    "sass": "^1.101.0",
    "vite": "^8.1.0",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
