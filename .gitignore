# Local reference and scratch areas
/references/
/sandbox/

# OS files
.DS_Store
Thumbs.db

# Editor and IDE settings
.idea/
.vscode/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node dependencies
node_modules/

# Local environment files
.env
.env.*
!.env.example

# Caches and generated outputs
.cache/
.temp/
tmp/
coverage/
dist/

# Workbench case-local generated files
/workbench/cases/*/current/node_modules/
/workbench/cases/*/remake/node_modules/
/workbench/cases/*/current/dist/
/workbench/cases/*/remake/dist/
/workbench/cases/*/current/.cache/
/workbench/cases/*/remake/.cache/
/workbench/cases/*/current/tmp/
/workbench/cases/*/remake/tmp/
/workbench/cases/*/current/logs/
/workbench/cases/*/remake/logs/
